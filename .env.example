SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_ACCESS_TOKEN=
CALI_ADMIN_TOKEN=
CALI_API_URL=http://192.168.12.155:21000

# Orb cognition provider routing
SPRUKED_ORB_COGNITION_PROVIDER=cali_skg
SPRUKED_ORB_PROVIDER_TIMEOUT_MS=120000
SPRUKED_ORB_VOICE_PROVIDER_TIMEOUT_MS=30000
SPRUKED_ORB_PROVIDER_FALLBACK=0

# CALI SKG + Ollama articulation settings
CALI_OLLAMA_MODEL_NAME=orb-local
CALI_LLM_PROVIDER=llama.cpp
CALI_LLM_BASE_URL=http://127.0.0.1:8081
OLLAMA_BASE_URL=http://127.0.0.1:11434
CALI_OLLAMA_MAX_TOKENS=140
CALI_OLLAMA_TEMPERATURE=0.45
CALI_OLLAMA_THREADS=8
CALI_OLLAMA_DEVICE=cuda
CALI_HYBRID_STRICT=0
CALI_HYBRID_USE_LOCAL_LLM=1
CALI_DOCTRINE_ENFORCE=1
CALI_DOCTRINE_REQUIRE_ENVELOPE=0

# ORB real-time voice lane: Qwen Cali profile first, Kokoro fallback.
ORB_TTS_KOKORO_URL=http://127.0.0.1:8880/speak
ORB_TTS_KOKORO_HEALTH_URL=http://127.0.0.1:8880/health
ORB_TTS_KOKORO_MODEL=kokoro
ORB_TTS_KOKORO_VOICE=af_heart
ORB_TTS_KOKORO_FORMAT=wav
ORB_TTS_KOKORO_SPEED=1.05
ORB_TTS_KOKORO_TIMEOUT_MS=45000

QWEN_TTS_ENGINE=qwen3-tts-06b-base
QWEN_TTS_BASE_URL=http://127.0.0.1:9880/speak
QWEN_TTS_HEALTH_URL=http://127.0.0.1:9880/health
QWEN_TTS_VOICE=cali_gpt_voice_sample
QWEN_TTS_TIMEOUT_MS=220000
FAST_WHISPER_URL=http://127.0.0.1:9000/stt

# Service port map
TTS_BRIDGE_PORT=8020
CALI_API_BACKEND_PORT=21000
CALI_FRONTEND_PORT=21010
ORB_BRIDGE_PORT=5199
MASTER_DASHBOARD_PORT=8100
DANDY_BACKEND_PORT=8010
R_SUBSTRATE_HTTP_PORT=9000
WSL_SERVICE_PORT=15000
OLLAMA_PORT=11434

# Cali X One provider
