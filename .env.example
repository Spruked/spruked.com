SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_ACCESS_TOKEN=
CALI_ADMIN_TOKEN=
CALI_API_URL=http://127.0.0.1:8022

# Simple Spruked admin login
# Username defaults to "admin" if SPRUKED_ADMIN_USERNAME is not set.
# If SPRUKED_ADMIN_PASSWORD is blank, the login bridge falls back to ADMIN_ACCESS_TOKEN.
# Set SPRUKED_ADMIN_PASSWORD in the deployment environment for a normal human password.
SPRUKED_ADMIN_USERNAME=admin
SPRUKED_ADMIN_PASSWORD=

# Orb cognition provider routing (no orb UI/core edits required)
SPRUKED_ORB_COGNITION_PROVIDER=kaygee_hybrid
SPRUKED_ORB_PROVIDER_TIMEOUT_MS=120000

# KayGee provider
KAYGEE_API_BASE=http://127.0.0.1:8011
KAYGEE_VOICE_ENABLED=1
KAYGEE_VOICE=af_bella
CALI_LOCAL_KOKORO_URL=http://127.0.0.1:12000/api/kokoro/tts
CALI_QWEN_TTS_URL=http://127.0.0.1:9880/speak
CALI_STT_API_URL=http://127.0.0.1:13000

# KayGee Hybrid (llama.cpp core + KayGee governance + Cali SKG articulation)
CALI_LLM_PROVIDER=llama_cpp
LLAMA_CPP_API_BASE=http://127.0.0.1:8080
CALI_LLAMA_CPP_MODEL_NAME=local-llama-cpp

# Optional Ollama fallback if CALI_LLM_PROVIDER=ollama
CALI_OLLAMA_MODEL_NAME=qwen3.5:4b
CALI_OLLAMA_MAX_TOKENS=140
CALI_OLLAMA_TEMPERATURE=0.45
CALI_OLLAMA_THREADS=8
CALI_OLLAMA_DEVICE=cuda
CALI_HYBRID_STRICT=0
CALI_HYBRID_USE_LLM=1
CALI_DOCTRINE_ENFORCE=1
CALI_DOCTRINE_REQUIRE_ENVELOPE=0

# Cali X One provider
CALIXONE_API_BASE=http://127.0.0.1:8021
CALIXONE_INTERACT_PATH=/api/interact
