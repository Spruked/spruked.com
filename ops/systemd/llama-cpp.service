[Unit]
Description=llama.cpp CUDA LLM server for CALI ORB
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bryan
Group=bryan
WorkingDirectory=/home/bryan/substrate/llm/llama.cpp
Environment=HOME=/home/bryan
Environment=CUDA_VISIBLE_DEVICES=0
Environment=LD_LIBRARY_PATH=/home/bryan/substrate/llm/llama.cpp/build-cuda/bin:/usr/local/cuda/lib64:/usr/lib/wsl/lib
ExecStart=/home/bryan/substrate/llm/llama.cpp/build-cuda/bin/llama-server --model /home/bryan/substrate/llm/models/Llama-3.2-3B-Instruct-GGUF/Llama-3.2-3B-Instruct-Q4_K_M.gguf --host 127.0.0.1 --port 8080 --n-gpu-layers all --ctx-size 4096 --parallel 2 --flash-attn on
Restart=always
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30
StartLimitIntervalSec=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
